[Desktop Entry]
Categories={{categories}}
Comment={{comment}}
Exec={{exec}} %F
StartupWMClass=snagcraft
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/avif;image/tiff
Actions=Capture;Region;

[Desktop Action Capture]
Name=Capture screen
Exec={{exec}} --capture

[Desktop Action Region]
Name=Capture region
Exec={{exec}} --region
